#!/bin/sh
# Blocks pushes to main: changes reach main only through a pull request on GitHub.
#
# Git runs this before every push, on this computer only; GitHub never runs it.
# Turn it on once per clone:   git config core.hooksPath .githooks
# Emergency bypass:            git push --no-verify
#
# Git passes one line per branch being pushed: <local ref> <local sha> <remote ref> <remote sha>
while read -r local_ref local_sha remote_ref remote_sha; do
  if [ "$remote_ref" = "refs/heads/main" ]; then
    echo "pre-push: pushing to main is blocked. Push a branch and open a pull request instead." >&2
    exit 1
  fi
done
exit 0
