---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { priceRange } from '../lib/format';

interface Props {
  products: CollectionEntry<'products'>[];
}

const { products } = Astro.props;
---

<!-- Pinned horizontal strip: the section is tall, its inner frame sticks to the screen, and
     scrolling down moves the track sideways. Without support (or with reduced motion) it is
     a normal row you can swipe through. -->
<section class="strip" aria-label="Single origin">
  <div class="frame">
    <p class="label container">Single origin · {products.length} gardens</p>
    <div class="track">
      {products.map((product) => (
        <article class="panel">
          <div class="text">
            <p class="region" aria-hidden="true">{product.data.origin?.region}</p>
            <p class="place">{product.data.origin?.region}, {product.data.origin?.prefecture}</p>
            <h2>{product.data.name}</h2>
            <p class="summary">{product.data.summary}</p>
            <p class="price">{priceRange(product.data.variants)}</p>
            <a class="button" href={`/product/${product.id}/`}>View product</a>
          </div>
          <Image
            src={product.data.images[0].src}
            alt={product.data.images[0].alt}
            widths={[480, 960]}
            sizes="(max-width: 781px) 75vw, 420px"
          />
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  /* Fallback first: a swipeable row. */
  .frame {
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding-block: 80px;
    background: var(--color-sand);
  }
  .label {
    margin: 0 auto 30px;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-matcha);
  }
  .track {
    display: flex;
    width: max-content;
  }
  .panel {
    flex: none;
    width: min(80vw, 1100px);
    padding-inline: 5vw;
    display: grid;
    grid-template-columns: 1fr minmax(0, 420px);
    align-items: center;
    gap: 5vw;
    scroll-snap-align: start;
  }
  .region {
    /* Room below for descenders, like the j in "Uji". */
    margin: 0 0 0.22em;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(90px, 16vw, 230px);
    line-height: 0.9;
    color: var(--color-matcha);
    opacity: 0.85;
  }
  .place {
    margin: 0 0 6px;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-stone-strong);
  }
  h2 {
    font-size: clamp(26px, 2.6vw, 34px);
    line-height: 1.2;
    margin: 0 0 12px;
  }
  .summary {
    margin: 0 0 12px;
    max-width: 36ch;
  }
  .price {
    margin: 0 0 24px;
    font-weight: 600;
  }
  .panel :global(img) {
    width: 100%;
    height: min(60svh, 560px);
    object-fit: cover;
  }

  /* Enhanced: the strip is three screens tall and the frame sticks, so vertical scrolling
     drives the sideways movement. Longhands: the minifier would fold animation-timeline into
     the shorthand, which Chrome rejects. */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .strip {
        height: 300vh;
        view-timeline-name: --strip;
      }
      .frame {
        position: sticky;
        top: 0;
        height: 100svh;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        justify-content: center;
        padding-block: 0;
      }
      .track {
        animation-name: slide;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: --strip;
        animation-range: contain 0% contain 100%;
      }
    }
  }
  /* Ends with the last panel's right edge at the screen's right edge. */
  @keyframes slide {
    to {
      transform: translateX(calc(-100% + 100vw));
    }
  }

  @media (max-width: 781.98px) {
    .panel {
      width: 86vw;
      grid-template-columns: 1fr;
      gap: 20px;
    }
    .panel :global(img) {
      height: 34svh;
    }
    .region {
      font-size: 72px;
    }
  }
</style>
