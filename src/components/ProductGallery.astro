---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  images: CollectionEntry<'products'>['data']['images'];
}

const { images } = Astro.props;
---

<!-- Wide screens: every photo stacked, scrolled past beside the pinned purchase panel.
     Phones: a swipeable row. CSS scroll-snap gives it the phone's own momentum and snapping,
     with no JavaScript; the script only updates the "1 / 3" counter. -->
<div class="gallery" data-gallery>
  <div class="track">
    {images.map((image, i) => (
      <Image
        src={image.src}
        alt={image.alt}
        widths={[640, 1280]}
        sizes="(max-width: 999px) 100vw, 55vw"
        loading={i === 0 ? 'eager' : 'lazy'}
        data-vt-product={i === 0 ? '' : undefined}
      />
    ))}
  </div>
  {images.length > 1 && <p class="counter" aria-hidden="true">1 / {images.length}</p>}
</div>

<script>
  const gallery = document.querySelector<HTMLElement>('[data-gallery]');
  const track = gallery?.querySelector<HTMLElement>('.track');
  const counter = gallery?.querySelector<HTMLElement>('.counter');
  if (track && counter) {
    const total = track.children.length;
    track.addEventListener(
      'scroll',
      () => (counter.textContent = `${Math.round(track.scrollLeft / track.clientWidth) + 1} / ${total}`),
      { passive: true },
    );
  }
</script>

<style>
  .track {
    display: grid;
    gap: 12px;
  }
  .track :global(img) {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }
  .counter {
    display: none;
  }

  @media (max-width: 999.98px) {
    /* Edge to edge on phones and tablets: the row bleeds past the page margins. */
    .gallery {
      position: relative;
      margin-inline: calc((100vw - var(--container)) / -2);
    }
    .track {
      display: flex;
      gap: 0;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      overscroll-behavior-x: contain;
      scrollbar-width: none;
    }
    .track::-webkit-scrollbar {
      display: none;
    }
    .track :global(img) {
      flex: 0 0 100%;
      scroll-snap-align: start;
      aspect-ratio: 1;
    }
    .counter {
      display: block;
      position: absolute;
      right: 16px;
      bottom: 14px;
      margin: 0;
      padding: 2px 10px;
      border-radius: 999px;
      background: rgb(248 246 241 / 0.85);
      font-size: 0.75rem;
      font-variant-numeric: tabular-nums;
    }
  }
</style>
