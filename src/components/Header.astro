---
import { categoryLinks } from '../data/categories';

const links = [
  { name: 'Journal', href: '/journal/' },
  { name: 'About', href: '/about/' },
  { name: 'Contact', href: '/contact/' },
];

// Runs at build time: each page gets its own HTML, so the current link is marked without JavaScript.
const current = (href: string) => (Astro.url.pathname === href ? 'page' : undefined);
// Like WordPress, "Shop" stays highlighted on category and product pages.
const inShop = /^\/(shop|product-category|product)\//.test(Astro.url.pathname);
// Home: the bar floats over the full-screen hero and starts hidden. Other pages: it starts
// visible, in the page's flow under the notice.
const isHome = Astro.url.pathname === '/';
---

<header class="site-header" data-home={isHome || undefined} data-visible={!isHome || undefined}>
  <div class="container bar">
    <a class="wordmark" href="/">Kohaku</a>

    <button class="menu-toggle" type="button" aria-label="Menu" aria-expanded="false" aria-controls="site-nav">
      <svg width="24" height="24" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M3 6h18M3 12h18M3 18h18" stroke="currentColor" stroke-width="1.5" />
      </svg>
    </button>

    <nav id="site-nav" class="nav" aria-label="Main">
      <button class="menu-close" type="button" aria-label="Close menu">×</button>
      <ul class="menu">
        <li class="has-sub" style="--i: 0">
          <a href="/shop/" aria-current={current('/shop/')} class:list={{ active: inShop }}>Shop</a>
          <ul class="sub">
            {categoryLinks.map((c) => (
              <li><a href={c.href} aria-current={current(c.href)}>{c.name}</a></li>
            ))}
          </ul>
        </li>
        {links.map((l, i) => (
          <li style={`--i: ${i + 1}`}><a href={l.href} aria-current={current(l.href)}>{l.name}</a></li>
        ))}
      </ul>
      <!-- Phones: closes the full-screen menu with the tagline instead of empty space. -->
      <p class="menu-foot" aria-hidden="true">Matcha, considered.</p>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle')!;
  const nav = document.querySelector<HTMLElement>('#site-nav')!;
  const close = nav.querySelector<HTMLButtonElement>('.menu-close')!;

  function setOpen(open: boolean) {
    toggle.setAttribute('aria-expanded', String(open));
    nav.toggleAttribute('data-open', open);
    (open ? close : toggle).focus();
  }

  toggle.addEventListener('click', () => setOpen(true));
  close.addEventListener('click', () => setOpen(false));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && nav.hasAttribute('data-open')) setOpen(false);
  });

  // Auto-hiding header, the usual way: it gets out of the way while you read (scrolling down)
  // and comes back when you scroll up looking for it. Home starts hidden; other pages visible.
  const header = document.querySelector<HTMLElement>('.site-header')!;
  let lastY = window.scrollY;
  let scrollingUp = !header.hasAttribute('data-home');

  const update = () => {
    const y = window.scrollY;
    // Ignore tiny movements so trackpad jitter doesn't flicker the header.
    if (Math.abs(y - lastY) > 4) {
      scrollingUp = y < lastY;
      lastY = y;
    }
    // Always show it while it has keyboard focus or the mobile menu is open.
    const show = scrollingUp || header.contains(document.activeElement) || nav.hasAttribute('data-open');
    header.toggleAttribute('data-visible', show);
  };

  // Browsers already fire scroll events at most once per frame, so no extra throttling.
  window.addEventListener('scroll', update, { passive: true });
  header.addEventListener('focusin', update);
  header.addEventListener('focusout', () => setTimeout(update));
  update();
</script>

<style>
  /* Auto-hide: moved up out of view until data-visible is set. Sticky, so on load it sits
     in the flow under the notice instead of covering it and the page's top. */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 90;
    transform: translateY(-100%);
    transition: transform 0.45s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  /* Home: floats over the full-screen hero, taking no space. */
  .site-header[data-home] {
    position: fixed;
    left: 0;
    right: 0;
  }
  /* "none" rather than translateY(0): any transform would trap the fixed mobile menu inside the header. */
  .site-header[data-visible] {
    transform: none;
  }
  /* Frosted paper: the page shows softly through the bar as it scrolls under. It's on a layer
     behind the content, not on the header itself: backdrop-filter on the header would make it
     the container for the fixed mobile menu and trap the menu inside the bar. */
  .site-header::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: rgb(248 246 241 / 0.75);
    -webkit-backdrop-filter: blur(20px) saturate(160%);
    backdrop-filter: blur(20px) saturate(160%);
  }
  /* A soft fade under the bar instead of a hard 1px line. */
  .site-header::after {
    content: '';
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    height: 14px;
    background: linear-gradient(rgb(26 26 26 / 0.05), transparent);
    pointer-events: none;
  }
  /* Increase contrast: a solid bar with a clear edge. */
  @media (prefers-contrast: more) {
    .site-header::before {
      background: var(--color-paper);
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
      border-bottom: 1px solid var(--color-ink);
    }
    .site-header::after {
      display: none;
    }
  }
  @media (prefers-reduced-transparency: reduce) {
    .site-header::before {
      background: var(--color-paper);
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .site-header {
      transition: none;
    }
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 80px;
  }

  /* Wordmark, from the WordPress Additional CSS */
  .wordmark {
    text-decoration: none;
    color: var(--color-ink);
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 1.5625rem;
    line-height: 1.05;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    /* The trailing letter-space after the final U would push the mark off-centre. */
    margin-right: -0.3em;
  }
  .wordmark:hover {
    color: var(--color-matcha);
  }

  .menu,
  .sub {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .menu {
    display: flex;
    gap: 28px;
  }
  .menu a {
    font-size: 0.9375rem;
    font-weight: 500;
    line-height: 1.3;
    text-decoration: none;
    color: var(--color-ink);
  }
  .menu a:hover,
  .menu a[aria-current='page'],
  .menu a.active {
    color: var(--color-matcha);
  }

  /* Shop dropdown: opens on hover and on keyboard focus, no JavaScript needed. */
  .has-sub {
    position: relative;
  }
  .has-sub > a::after {
    content: '';
    display: inline-block;
    width: 5px;
    height: 5px;
    margin: 0 0 3px 10px;
    border: solid currentColor;
    border-width: 0 1.5px 1.5px 0;
    transform: rotate(45deg);
  }
  .sub {
    display: none;
    position: absolute;
    top: 100%;
    left: -20px;
    min-width: 200px;
    padding-top: 10px;
    z-index: 50;
  }
  .has-sub:hover .sub,
  .has-sub:focus-within .sub {
    display: block;
  }
  .sub li {
    background: var(--color-night);
  }
  .sub li + li {
    border-top: 1px dashed rgba(255, 255, 255, 0.1);
  }
  .sub a {
    display: block;
    padding: 13px 20px;
    color: var(--color-white);
    font-weight: 500;
  }
  .sub a:hover {
    color: rgba(255, 255, 255, 0.7);
  }

  .menu-foot {
    display: none;
  }
  .menu-toggle,
  .menu-close {
    display: none;
    background: none;
    border: 0;
    padding: 8px;
    cursor: pointer;
    color: inherit;
  }

  /* Mobile: the nav becomes a full-screen paper panel that wipes down from the top, and
     the links rise in one after another. visibility (not display) keeps it animatable and
     still takes the closed menu out of the tab order. */
  @media (max-width: 999.98px) {
    .bar {
      height: 64px;
    }
    .menu-toggle {
      display: block;
    }
    .nav {
      display: flex;
      flex-direction: column;
      position: fixed;
      inset: 0;
      z-index: 100;
      padding: 110px 8vw 48px;
      overflow-y: auto;
      background: var(--color-paper);
      visibility: hidden;
      clip-path: inset(0 0 100% 0);
      transition:
        clip-path 0.6s cubic-bezier(0.7, 0, 0.2, 1),
        visibility 0s 0.6s;
    }
    .nav[data-open] {
      visibility: visible;
      clip-path: inset(0);
      transition: clip-path 0.6s cubic-bezier(0.7, 0, 0.2, 1);
    }
    .menu-close {
      display: block;
      position: absolute;
      top: 12px;
      right: 6vw;
      font-size: 2.25rem;
      font-weight: 300;
      line-height: 1;
    }
    .menu {
      flex-direction: column;
      gap: 6px;
    }
    .menu > li {
      opacity: 0;
      translate: 0 40px;
      /* Closing: fade out together as the panel retracts, then drop back into place unseen. */
      transition:
        opacity 0.15s ease,
        translate 0s 0.6s;
    }
    .nav[data-open] .menu > li {
      opacity: 1;
      translate: 0;
      transition:
        opacity 0.6s ease,
        translate 0.8s cubic-bezier(0.2, 0.7, 0.2, 1);
      transition-delay: calc(0.25s + var(--i) * 70ms);
    }
    .menu a {
      font-family: var(--font-display);
      font-size: clamp(2.75rem, 12vw, 4.5rem);
      font-weight: 600;
      line-height: 1.15;
      letter-spacing: -0.015em;
      text-transform: none;
    }
    .has-sub > a::after {
      display: none;
    }
    /* Categories: a small row under "Shop". */
    .sub {
      display: flex;
      flex-wrap: wrap;
      gap: 4px 20px;
      position: static;
      padding: 4px 0 18px;
    }
    .sub li,
    .sub li + li {
      background: none;
      border: 0;
    }
    .sub a {
      padding: 4px 0;
      font-family: var(--font-body);
      font-size: 0.9375rem;
      font-weight: 500;
      color: var(--color-stone-strong);
    }
    .menu-foot {
      display: block;
      margin: auto 0 0;
      padding-top: 48px;
      font-family: var(--font-display);
      font-weight: 600;
      font-size: clamp(1.5rem, 6vw, 2rem);
      letter-spacing: -0.01em;
      color: var(--color-matcha);
      opacity: 0;
      transition: opacity 0.15s ease;
    }
    .nav[data-open] .menu-foot {
      opacity: 1;
      transition: opacity 0.6s ease 0.6s;
    }
    /* The page behind doesn't scroll while the menu is open. */
    :global(html:has(.nav[data-open])) {
      overflow: hidden;
    }
  }
  /* Reduce motion: no wipe or rising links; the whole panel fades in and out. */
  @media (max-width: 999.98px) and (prefers-reduced-motion: reduce) {
    .nav {
      clip-path: none;
      opacity: 0;
      transition:
        opacity 0.2s ease,
        visibility 0s 0.2s;
    }
    .nav[data-open] {
      clip-path: none;
      opacity: 1;
      transition: opacity 0.2s ease;
    }
    .menu > li,
    .nav[data-open] .menu > li {
      opacity: 1;
      translate: none;
      transition: none;
    }
  }

  @media (max-width: 689px) {
    .wordmark {
      font-size: 1.25rem;
      letter-spacing: 0.24em;
    }
  }
</style>
