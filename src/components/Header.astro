---
import { categoryLinks } from '../data/categories';

const links = [
  { name: 'Journal', href: '/journal/' },
  { name: 'About', href: '/about/' },
  { name: 'Contact', href: '/contact/' },
];

// Runs at build time: each page gets its own HTML, so the current link is marked without JavaScript.
const current = (href: string) => (Astro.url.pathname === href ? 'page' : undefined);
// Like WordPress, "Shop" stays highlighted on category and product pages.
const inShop = /^\/(shop|product-category|product)\//.test(Astro.url.pathname);
---

<header class="site-header">
  <div class="container bar">
    <a class="wordmark" href="/">Kohaku</a>

    <button class="menu-toggle" type="button" aria-label="Menu" aria-expanded="false" aria-controls="site-nav">
      <svg width="24" height="24" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M3 6h18M3 12h18M3 18h18" stroke="currentColor" stroke-width="1.5" />
      </svg>
    </button>

    <nav id="site-nav" class="nav" aria-label="Main">
      <button class="menu-close" type="button" aria-label="Close menu">×</button>
      <ul class="menu">
        <li class="has-sub">
          <a href="/shop/" aria-current={current('/shop/')} class:list={{ active: inShop }}>Shop</a>
          <ul class="sub">
            {categoryLinks.map((c) => (
              <li><a href={c.href} aria-current={current(c.href)}>{c.name}</a></li>
            ))}
          </ul>
        </li>
        {links.map((l) => (
          <li><a href={l.href} aria-current={current(l.href)}>{l.name}</a></li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle')!;
  const nav = document.querySelector<HTMLElement>('#site-nav')!;
  const close = nav.querySelector<HTMLButtonElement>('.menu-close')!;

  function setOpen(open: boolean) {
    toggle.setAttribute('aria-expanded', String(open));
    nav.toggleAttribute('data-open', open);
    (open ? close : toggle).focus();
  }

  toggle.addEventListener('click', () => setOpen(true));
  close.addEventListener('click', () => setOpen(false));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && nav.hasAttribute('data-open')) setOpen(false);
  });
</script>

<style>
  .site-header {
    background: var(--color-white);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 120px;
  }

  /* Wordmark, from the WordPress Additional CSS */
  .wordmark {
    text-decoration: none;
    color: var(--color-ink);
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 25px;
    line-height: 1.05;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    /* The trailing letter-space after the final U would push the mark off-centre. */
    margin-right: -0.3em;
  }
  .wordmark:hover {
    color: var(--color-matcha);
  }

  .menu,
  .sub {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .menu {
    display: flex;
    gap: 25px;
  }
  .menu a {
    font-size: 12px;
    font-weight: 700;
    line-height: 1.3;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--color-ink);
  }
  .menu a:hover,
  .menu a[aria-current='page'],
  .menu a.active {
    color: var(--color-matcha);
  }

  /* Shop dropdown: opens on hover and on keyboard focus, no JavaScript needed. */
  .has-sub {
    position: relative;
  }
  .has-sub > a::after {
    content: '';
    display: inline-block;
    width: 5px;
    height: 5px;
    margin: 0 0 3px 10px;
    border: solid currentColor;
    border-width: 0 1.5px 1.5px 0;
    transform: rotate(45deg);
  }
  .sub {
    display: none;
    position: absolute;
    top: 100%;
    left: -20px;
    min-width: 200px;
    padding-top: 10px;
    z-index: 50;
  }
  .has-sub:hover .sub,
  .has-sub:focus-within .sub {
    display: block;
  }
  .sub li {
    background: var(--color-night);
  }
  .sub li + li {
    border-top: 1px dashed rgba(255, 255, 255, 0.1);
  }
  .sub a {
    display: block;
    padding: 13px 20px;
    color: var(--color-white);
    font-weight: 500;
  }
  .sub a:hover {
    color: rgba(255, 255, 255, 0.7);
  }

  .menu-toggle,
  .menu-close {
    display: none;
    background: none;
    border: 0;
    padding: 8px;
    cursor: pointer;
    color: inherit;
  }

  /* Mobile: the same nav becomes a dark side panel, as in Blocksy. */
  @media (max-width: 999.98px) {
    .bar {
      height: 70px;
    }
    .menu-toggle {
      display: block;
    }
    .nav {
      display: none;
    }
    .nav[data-open] {
      display: block;
      position: fixed;
      inset: 0 0 0 auto;
      width: min(500px, 100%);
      padding: 80px 40px 40px;
      background: rgba(18, 21, 25, 0.98);
      box-shadow: 0 0 70px rgba(0, 0, 0, 0.35);
      overflow-y: auto;
      z-index: 100;
    }
    .menu-close {
      display: block;
      position: absolute;
      top: 20px;
      right: 24px;
      font-size: 32px;
      line-height: 1;
      color: var(--color-white);
    }
    .menu {
      flex-direction: column;
      gap: 20px;
    }
    .menu a {
      font-size: 20px;
      text-transform: none;
      color: var(--color-white);
    }
    /* Matcha green is too dark on the black panel, so the current page is underlined instead. */
    .menu a[aria-current='page'],
    .menu a.active {
      color: var(--color-white);
      text-decoration: underline;
      text-underline-offset: 6px;
    }
    .sub {
      display: block;
      position: static;
      padding: 12px 0 0 16px;
    }
    .sub li {
      background: none;
    }
    .sub li + li {
      border: 0;
    }
    .sub a {
      padding: 6px 0;
      font-size: 16px;
    }
  }

  @media (max-width: 689px) {
    .wordmark {
      font-size: 20px;
      letter-spacing: 0.24em;
    }
  }
</style>
