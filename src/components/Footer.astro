---
import { categoryLinks } from '../data/categories';

const kohakuLinks = [
  { name: 'About', href: '/about/' },
  { name: 'Journal', href: '/journal/' },
  { name: 'Contact', href: '/contact/' },
  { name: 'Privacy Policy', href: '/privacy-policy/' },
  { name: 'Refunds & Returns', href: '/refund_returns/' },
];

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container columns">
    <div>
      <p class="brand">Kohaku</p>
      <p class="tagline">single-origin matcha</p>
      <p class="blurb">Shade-grown matcha from four Japanese gardens, kept separate and sold young.</p>
    </div>

    <nav aria-label="Shop">
      <h2>Shop</h2>
      <ul>
        {categoryLinks.map((l) => <li><a href={l.href}>{l.name}</a></li>)}
      </ul>
    </nav>

    <nav aria-label="Kohaku">
      <h2>Kohaku</h2>
      <ul>
        {kohakuLinks.map((l) => <li><a href={l.href}>{l.name}</a></li>)}
      </ul>
    </nav>
  </div>

  <div class="container copyright">© {year} Kohaku</div>
</footer>

<style>
  .site-footer {
    background: var(--color-sand);
    /* Fluid size from the WordPress blocks: 14px on phones up to 15px on desktop. */
    --footer-text: clamp(14px, 0.875rem + ((1vw - 3.2px) * 0.078), 15px);
  }
  .columns {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 50px;
    padding: 70px 0;
  }

  .brand {
    font-size: clamp(14px, 0.875rem + ((1vw - 3.2px) * 0.469), 20px);
    letter-spacing: 0.3em;
    text-transform: uppercase;
  }
  .tagline {
    font-size: var(--footer-text);
    font-style: italic;
    color: var(--color-stone);
  }
  .blurb {
    margin: 0;
    font-size: var(--footer-text);
    line-height: 1.75;
  }

  h2 {
    margin: 0 0 1em;
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-matcha);
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: var(--footer-text);
    line-height: 2;
  }
  a {
    text-decoration: none;
  }

  .copyright {
    padding: 25px 0;
    font-size: 15px;
    line-height: 1.3;
  }

  @media (max-width: 999.98px) {
    .columns {
      grid-template-columns: 1fr;
      padding: 50px 0;
    }
    .copyright {
      padding: 15px 0;
    }
  }
  @media (max-width: 689px) {
    .columns {
      padding: 40px 0;
    }
  }
</style>
