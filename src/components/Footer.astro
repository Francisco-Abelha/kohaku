---
import { categoryLinks } from '../data/categories';

const kohakuLinks = [
  { name: 'About', href: '/about/' },
  { name: 'Journal', href: '/journal/' },
  { name: 'Contact', href: '/contact/' },
  { name: 'Privacy policy', href: '/privacy-policy/' },
  { name: 'Refunds and returns', href: '/refund_returns/' },
];

const year = new Date().getFullYear();
---

<!-- Revealed from underneath: the footer sticks to the bottom of the screen behind <main>,
     which scrolls up off it like a lifted sheet (styles in global.css and below). -->
<footer class="site-footer">
  <div class="container columns">
    <div>
      <p class="closing">Matcha, considered.</p>
      <p class="blurb">Shade-grown matcha from four Japanese gardens, kept separate and sold young.</p>
    </div>

    <nav aria-label="Shop">
      <h2>Shop</h2>
      <ul>
        {categoryLinks.map((l) => <li><a href={l.href}>{l.name}</a></li>)}
      </ul>
    </nav>

    <nav aria-label="Kohaku">
      <h2>Kohaku</h2>
      <ul>
        {kohakuLinks.map((l) => <li><a href={l.href}>{l.name}</a></li>)}
      </ul>
    </nav>
  </div>

  <!-- Giant wordmark; it rises into place as the footer comes into view. -->
  <p class="mark" aria-hidden="true">Kohaku</p>

  <div class="container copyright">
    <span>© {year} Kohaku</span>
    <span>Concept store. No real orders are taken.</span>
  </div>
</footer>

<style>
  .site-footer {
    overflow: hidden;
    background: var(--color-sand);
  }
  /* Only where the whole footer (about 630px) fits on screen: a stuck footer taller than
     the screen could never show its top. */
  @media (min-height: 700px) {
    .site-footer {
      position: sticky;
      bottom: 0;
    }
  }
  .columns {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: 50px;
    padding: 90px 0 40px;
  }

  .closing {
    margin: 0 0 16px;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(2.25rem, 4vw, 3.5rem);
    line-height: 1.05;
    letter-spacing: -0.015em;
  }
  .blurb {
    max-width: 36ch;
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.75;
    color: var(--color-stone-strong);
  }

  h2 {
    margin: 0 0 1em;
    font-family: var(--font-body);
    font-size: 0.9375rem;
    font-weight: 500;
    letter-spacing: 0;
    color: var(--color-stone-strong);
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 0.9375rem;
    line-height: 2;
  }
  a {
    text-decoration: none;
  }

  .mark {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 600;
    /* Wide enough to span the screen: 6 letters plus their letter-spacing. */
    font-size: 21vw;
    line-height: 0.8;
    letter-spacing: 0.06em;
    text-align: center;
    text-transform: uppercase;
    color: var(--color-matcha);
    opacity: 0.9;
    white-space: nowrap;
  }

  .copyright {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 24px;
    padding: 22px 0;
    font-size: 0.75rem;
    letter-spacing: 0.05em;
    color: var(--color-stone-strong);
  }

  /* The wordmark rises during the first 400px of <main> lifting off the footer (the
     --page-end timeline is <main>'s, see global.css). Longhands: the minifier would fold
     animation-timeline into the shorthand, which Chrome rejects. */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .mark {
        animation-name: mark-rise;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: --page-end;
        animation-range-start: exit 0px;
        animation-range-end: exit 400px;
      }
    }
  }
  @keyframes mark-rise {
    from {
      translate: 0 45%;
      opacity: 0;
    }
  }

  @media (max-width: 999.98px) {
    .columns {
      grid-template-columns: 1fr 1fr;
      padding: 60px 0 32px;
    }
    .columns > div {
      grid-column: 1 / -1;
    }
  }
</style>
