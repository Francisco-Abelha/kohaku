---
// The brand's brushstroke circle. Pages size and animate it themselves through the `enso`
// class (with :global, since this markup lives in its own component).
---

<svg class="enso" viewBox="0 0 400 400" aria-hidden="true">
  <defs>
    <!-- Turbulence roughens the stroke's edge, like a brush on paper. -->
    <filter id="enso-brush">
      <feTurbulence type="fractalNoise" baseFrequency="0.035" numOctaves="2" seed="7" />
      <feDisplacementMap in="SourceGraphic" scale="9" />
    </filter>
  </defs>
  <path d="M254.7 49.6 A160 156 -8 1 1 172.2 42.4" pathLength="1" filter="url(#enso-brush)" />
</svg>
