---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { formatDate } from '../lib/format';

interface Props {
  posts: CollectionEntry<'journal'>[];
  /** Heading level of each post title: 2 on /journal/, 3 under the home page's section heading. */
  level?: 2 | 3;
}

const { posts, level = 2 } = Astro.props;
const Title = level === 3 ? 'h3' : 'h2';
---

<!-- Editorial list: one row per post, title first, a small photo on the right. -->
<ul class="posts">
  {posts.map((post) => (
    <li>
      <a href={`/${post.id}/`}>
        <div class="text">
          <Title class="title">{post.data.title}</Title>
          <p class="excerpt">{post.data.excerpt}</p>
          <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
        </div>
        <Image src={post.data.cover} alt="" widths={[320, 640]} sizes="(max-width: 689px) 88vw, 280px" />
      </a>
    </li>
  ))}
</ul>

<style>
  .posts {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid rgb(139 132 120 / 0.3);
  }
  li {
    border-bottom: 1px solid rgb(139 132 120 / 0.3);
  }
  a {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 280px;
    gap: 6vw;
    align-items: center;
    padding: 40px 0;
    text-decoration: none;
    color: var(--color-ink);
  }
  .title {
    margin: 0 0 12px;
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    line-height: 1.1;
    letter-spacing: -0.015em;
    transition: color 0.3s ease;
  }
  a:hover .title,
  a:focus-visible .title {
    color: var(--color-matcha);
  }
  .excerpt {
    max-width: 56ch;
    margin: 0 0 14px;
    color: var(--color-ink);
  }
  time {
    font-size: 0.875rem;
    color: var(--color-stone-strong);
  }
  a :global(img) {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  @media (max-width: 689.98px) {
    a {
      grid-template-columns: 1fr;
      gap: 20px;
    }
    a :global(img) {
      order: -1;
    }
  }
</style>
