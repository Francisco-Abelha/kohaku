---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  items: { slug: string; name: string; count: number; image: ImageMetadata }[];
}

const { items } = Astro.props;
---

<!-- Each row is a real link to its category page; the shop's script turns clicks into
     filtering when JavaScript runs. data-category-index lets that script find them. -->
<section class="index first-screen" data-category-index>
  <div class="container inner">
    <h1 class="title">Shop</h1>
    <ol class="categories">
      {items.map((item, i) => (
        <li>
          <a href={`/product-category/${item.slug}/`} data-category={item.slug}>
            <span class="num">{String(i + 1).padStart(2, '0')}</span>
            <span class="name">{item.name}</span>
            <span class="count">{item.count} {item.count === 1 ? 'product' : 'products'}</span>
            <Image class="thumb" src={item.image} alt="" widths={[160, 320]} sizes="72px" loading="lazy" />
          </a>
        </li>
      ))}
    </ol>
  </div>

  <!-- The photo that trails the cursor while a row is hovered (mouse devices only). -->
  <div class="follower" aria-hidden="true">
    {items.map((item) => (
      <Image src={item.image} alt="" data-for={item.slug} widths={[400, 700]} sizes="320px" />
    ))}
  </div>
</section>

<script>
  const index = document.querySelector<HTMLElement>('[data-category-index]');
  if (index && matchMedia('(hover: hover) and (prefers-reduced-motion: no-preference)').matches) {
    const follower = index.querySelector<HTMLElement>('.follower')!;
    const photos = [...follower.querySelectorAll<HTMLImageElement>('img')];
    index.setAttribute('data-follow', '');

    // Centre the photo on the cursor. The CSS transition on translate makes it trail behind.
    index.addEventListener('pointermove', (event) => {
      const r = index.getBoundingClientRect();
      follower.style.translate = `${event.clientX - r.left - follower.offsetWidth / 2}px ${event.clientY - r.top - follower.offsetHeight / 2}px`;
    });
    for (const link of index.querySelectorAll<HTMLAnchorElement>('a[data-category]')) {
      link.addEventListener('pointerenter', () => {
        index.setAttribute('data-hovering', '');
        photos.forEach((img) => img.classList.toggle('active', img.dataset.for === link.dataset.category));
      });
      link.addEventListener('pointerleave', () => index.removeAttribute('data-hovering'));
    }
  }
</script>

<style>
  .index {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
    overflow: hidden;
  }
  .inner {
    position: relative;
    z-index: 1; /* text above the trailing photo */
    padding-block: 90px 60px;
  }
  .title {
    font-size: 30px;
    margin: 0 0 40px;
  }

  .categories {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--color-stone);
  }
  .categories li {
    border-bottom: 1px solid var(--color-stone);
  }
  .categories a {
    display: grid;
    grid-template-columns: 64px 1fr auto;
    align-items: baseline;
    gap: 16px;
    padding: clamp(14px, 2vw, 26px) 0;
    color: var(--color-ink);
    text-decoration: none;
    transition: opacity 0.4s ease;
  }
  .num,
  .count {
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-stone-strong);
  }
  .name {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(40px, 7vw, 96px);
    line-height: 1.05;
    transition: transform 0.6s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .categories a:focus-visible .name {
    color: var(--color-matcha);
  }
  .thumb {
    display: none;
  }

  /* Mouse + motion: hovering a row dims the others, slides its name, shows the trailing photo. */
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .categories:hover a {
      opacity: 0.3;
    }
    .categories a:hover,
    .categories a:focus-visible {
      opacity: 1;
    }
    .categories a:hover .name,
    .categories a:focus-visible .name {
      transform: translateX(24px);
    }
  }
  /* Touch screens or reduced motion: a small photo beside each name instead. */
  @media (hover: none), (prefers-reduced-motion: reduce) {
    .categories a {
      grid-template-columns: 40px 1fr auto;
      align-items: center;
    }
    .count {
      display: none;
    }
    .thumb {
      display: block;
      width: 72px;
      aspect-ratio: 1;
      object-fit: cover;
    }
  }

  .follower {
    position: absolute;
    top: 0;
    left: 0;
    width: 320px;
    aspect-ratio: 4 / 5;
    pointer-events: none;
    opacity: 0;
    scale: 0.9;
    transition:
      translate 0.55s cubic-bezier(0.2, 0.7, 0.2, 1),
      opacity 0.35s ease,
      scale 0.5s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .index:not([data-follow]) .follower {
    display: none;
  }
  .index[data-hovering] .follower {
    opacity: 1;
    scale: 1;
  }
  .follower :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 0.35s ease;
  }
  .follower :global(img.active) {
    opacity: 1;
  }
</style>
