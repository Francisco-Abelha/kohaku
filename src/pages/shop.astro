---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ShopLookbook from '../components/ShopLookbook.astro';

const products = await getCollection('products');
---

<BaseLayout title="Shop" description="Single-origin and daily matcha, hojicha, the tools to prepare them, and gift sets.">
  <ShopLookbook products={products} />
</BaseLayout>
