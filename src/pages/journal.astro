---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import JournalList from '../components/JournalList.astro';

const posts = (await getCollection('journal')).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<BaseLayout title="Journal">
  <div class="container journal first-screen">
    <h1>Journal</h1>
    <p class="intro">Notes on gardens, grades and getting a smooth bowl.</p>
    <JournalList posts={posts} />
  </div>
</BaseLayout>

<style>
  .journal {
    padding: 60px 0 100px;
  }
  h1 {
    /* Room for the J's descender above the intro line. */
    margin: 0 0 0.3em;
    font-size: clamp(4rem, 10vw, 9.375rem);
    line-height: 0.9;
    letter-spacing: -0.02em;
  }
  .intro {
    max-width: 48ch;
    margin: 0 0 56px;
    font-size: 1.125rem;
    color: var(--color-stone-strong);
  }
</style>
