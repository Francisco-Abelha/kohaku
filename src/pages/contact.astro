---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<!-- Text and sizes copied from the WordPress Contact page. -->
<BaseLayout title="Contact" description="Questions about matcha, grades or preparation? Get in touch with Kohaku.">
  <div class="first-screen contact-screen">
  <section class="contact">
    <h1>Get in touch</h1>
    <p class="intro">
      Questions about a harvest, an order, or which garden to start with — we read everything and reply within two
      working days.
    </p>

    <div class="columns">
      <!-- Checked as you go and on the server (src/lib/forms.ts); the script is in BaseLayout. -->
      <form data-form="contact">
        <label class="visually-hidden" for="contact-name">Name</label>
        <input class="field" id="contact-name" name="name" type="text" placeholder="Name" autocomplete="name" maxlength="100" aria-describedby="contact-name-error" required />
        <p class="error" id="contact-name-error"></p>
        <label class="visually-hidden" for="contact-email">Email address</label>
        <input class="field" id="contact-email" name="email" type="email" placeholder="Email address" autocomplete="email" aria-describedby="contact-email-error" required />
        <p class="error" id="contact-email-error"></p>
        <label class="visually-hidden" for="contact-message">Message</label>
        <textarea class="field" id="contact-message" name="message" rows="5" placeholder="How can we help?" maxlength="5000" aria-describedby="contact-message-error" required></textarea>
        <p class="error" id="contact-message-error"></p>
        <!-- Honeypot: hidden from people; spam bots fill it in, and the server then ignores the submission. -->
        <div class="hp" aria-hidden="true"><label>Company <input name="company" tabindex="-1" autocomplete="off" /></label></div>
        <button class="button" type="submit">Send message</button>
        <p class="note" role="status"></p>
      </form>

      <div class="details">
        <h3 class="eyebrow">Studio</h3>
        <p>54 Wythe Avenue, Studio 3<br />Brooklyn, NY 11249</p>
        <h3 class="eyebrow">Hours</h3>
        <p>Monday to Friday<br />9am – 5pm ET</p>
      </div>
    </div>
  </section>
  </div>
</BaseLayout>

<style>
  /* The section is centred in the space under the title, filling the first screen. */
  .contact-screen {
    display: flex;
    flex-direction: column;
  }
  .contact {
    width: 100%;
    max-width: 1168px;
    margin: auto;
    padding: clamp(72px, 9vw, 120px) 24px;
  }
  h1 {
    font-size: clamp(3rem, 7vw, 5.5rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
    margin-bottom: 20px;
  }
  .intro {
    font-size: clamp(0.875rem, 0.875rem + ((1vw - 3.2px) * 0.313), 1.125rem);
    line-height: 1.7;
    margin-bottom: 56px;
  }

  .columns {
    display: grid;
    grid-template-columns: 58fr 42fr;
    gap: 72px;
  }
  form {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
  }
  textarea {
    resize: vertical;
  }
  form .button {
    margin-top: 8px;
    padding: 17px 38px;
  }
  .error {
    /* Sits close under its field, not a full form gap away. */
    margin: -8px 0 0;
  }
  .note {
    margin: 0;
    font-size: 0.875rem;
    color: var(--color-matcha);
  }

  .eyebrow {
    margin: 0 0 6px;
    color: var(--color-stone-strong);
    font-family: var(--font-body);
    font-size: 0.9375rem;
    font-weight: 500;
    line-height: 1.5;
  }
  .details p {
    font-size: clamp(0.875rem, 0.875rem + ((1vw - 3.2px) * 0.156), 1rem);
    line-height: 1.8;
    margin-bottom: 36px;
  }

  @media (max-width: 781.98px) {
    .columns {
      grid-template-columns: 1fr;
      gap: 48px;
    }
  }
</style>
