---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<!-- Netlify serves dist/404.html for any URL that doesn't exist. -->
<BaseLayout title="Page not found">
  <div class="container-narrow not-found first-screen">
    <h1>Oops! That page can’t be found.</h1>
    <p>It looks like nothing was found at this location. Maybe try the shop or the journal instead.</p>
    <div class="actions">
      <a class="button" href="/shop/">Shop</a>
      <a class="button ghost" href="/journal/">Journal</a>
    </div>
  </div>
</BaseLayout>

<style>
  /* Centred in the full first screen. */
  .not-found {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 100px 0;
    text-align: center;
  }
  h1 {
    font-size: 2.5rem;
    line-height: 1.3;
  }
  .actions {
    display: flex;
    justify-content: center;
    gap: 10px;
    margin-top: 30px;
  }
</style>
