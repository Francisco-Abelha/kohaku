---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductCard from '../components/ProductCard.astro';
import heroImage from '../assets/products/matcha-bowl-primary-scaled.jpg';
import storyImage from '../assets/products/matcha-lifestyle-scaled.jpg';
import singleOriginImage from '../assets/products/uji-mockup.jpg';
import dailyImage from '../assets/products/matcha-latte-warm.jpg';
import equipmentImage from '../assets/products/matcha-whisk-closeup-scaled.jpg';

// The filter runs on every product; WordPress lists the featured ones by name.
const featured = (await getCollection('products', (p) => p.data.featured)).sort((a, b) =>
  a.data.name.localeCompare(b.data.name),
);

const posts = (await getCollection('journal'))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);

const tiles = [
  { name: 'Single Origin', href: '/product-category/single-origin/', image: singleOriginImage, alt: 'Kohaku Ceremonial Uji matcha pouch' },
  { name: 'Daily', href: '/product-category/daily/', image: dailyImage, alt: 'A matcha latte in a dark cup on a pale marble surface' },
  { name: 'Equipment', href: '/product-category/equipment/', image: equipmentImage, alt: 'A bamboo chasen whisking matcha in a bowl' },
];
---

<BaseLayout fullScreenHero>
  <section class="hero">
    <!-- Ensō: a brush circle, drawn on load. The filter roughens the edges like a brush stroke. -->
    <svg class="enso" viewBox="0 0 400 400" aria-hidden="true">
      <defs>
        <filter id="enso-brush">
          <feTurbulence type="fractalNoise" baseFrequency="0.035" numOctaves="2" seed="7" />
          <feDisplacementMap in="SourceGraphic" scale="9" />
        </filter>
      </defs>
      <path d="M254.7 49.6 A160 156 -8 1 1 172.2 42.4" pathLength="1" filter="url(#enso-brush)" />
    </svg>

    <div class="hero-content">
      <!-- Each word rises inside its own clipping window; --i sets its place in the sequence.
           {' '} is the space between words: Astro drops the line break between the tags. -->
      <h1>
        <span class="word"><span style="--i: 0">Matcha,</span></span>{' '}<span class="word"><span style="--i: 1">considered.</span></span>
      </h1>
      <p class="intro-in" style="--d: 0.8s">Single-origin, stone-milled, and shipped within weeks of harvest.</p>
      <div class="actions intro-in" style="--d: 1s">
        <a class="button" href="/product-category/single-origin/">Shop Single Origin</a>
        <a class="button ghost" href="/shop/">All Tea</a>
      </div>
    </div>

    <div class="frame">
      <p class="corner tl">Uji · Nishio · Yame</p>
      <p class="corner tr">First harvest only</p>
      <p class="corner bl">Est. 2023</p>
      <span class="corner br scroll" aria-hidden="true">Scroll</span>
    </div>
  </section>

  <!-- The layer wrapper puts the photo above "Our story", which slides out from under it. -->
  <div class="cover-layer">
  <div class="cover">
    <Image
      src={heroImage}
      alt="A white speckled ceramic chawan resting on a pale surface"
      widths={[828, 1280, 1920, 2560]}
      sizes="100vw"
      loading="eager"
    />
  </div>
  </div>

  <section class="section story">
    <div class="story-text">
      <p class="eyebrow">Our story</p>
      <h2>Four gardens, kept apart.</h2>
      <p>
        Kohaku began with a small frustration: nearly every matcha sold abroad is blended, and blending averages
        away the thing worth tasting. We work with four gardens across Uji, Nishio and Yame, and we keep each
        harvest separate — whatever that costs us in consistency. The tea changes from one year to the next. We
        think that is the point.
      </p>
      <p class="more"><a href="/about/">Read our story →</a></p>
    </div>
    <Image
      src={storyImage}
      alt="Matcha powder, a black chawan with bamboo whisk, and an iced matcha on a grey surface"
      widths={[560, 1120]}
      sizes="(max-width: 781px) 88vw, 524px"
    />
  </section>

  <section class="section">
    <h2 class="centered" data-reveal>Where to start</h2>
    <p class="intro" data-reveal>Three single-origin gardens and one everyday bowl.</p>
    <ul class="product-grid inner" data-reveal="stagger">
      {featured.map((product) => <li><ProductCard product={product} /></li>)}
    </ul>
  </section>

  <section class="section tiles" aria-label="Shop by category" data-reveal="stagger">
    {tiles.map((tile) => (
      <div class="tile">
        <Image src={tile.image} alt={tile.alt} widths={[400, 800]} sizes="(max-width: 781px) 88vw, 380px" />
        <h3>{tile.name}</h3>
        <a href={tile.href}>Shop →</a>
      </div>
    ))}
  </section>

  <section class="section">
    <h2 class="centered journal-title" data-reveal>From the Journal</h2>
    <ul class="posts inner" data-reveal="stagger">
      {posts.map((post) => (
        <li>
          <a href={`/${post.id}/`} tabindex="-1" aria-hidden="true">
            <Image src={post.data.cover} alt="" widths={[400, 768]} sizes="(max-width: 781px) 88vw, 380px" />
          </a>
          <a class="post-title" href={`/${post.id}/`}>{post.data.title}</a>
          <p>{post.data.excerpt}</p>
        </li>
      ))}
    </ul>
  </section>

  <section class="signup-section" data-reveal>
    <hr />
    <h2>Brewing guides and seasonal launches</h2>
    <p>A short letter when a new harvest lands. Nothing else.</p>
    <!-- shortcut: demo form like on WordPress, stores nothing; the real newsletter comes in phase 4. -->
    <form class="signup" data-demo>
      <label for="signup-email" class="visually-hidden">Email address</label>
      <input id="signup-email" class="field" type="email" name="email" placeholder="Email address" required />
      <button class="button" type="submit">Subscribe</button>
      <p class="note" role="status" hidden>Thank you — this is a demo form and does not store your address.</p>
    </form>
  </section>
</BaseLayout>

<style>
  /* Sizes and spacing copied from the WordPress blocks' inline styles. */
  h2 {
    font-size: clamp(30px, 4vw, 42px);
    line-height: 1.2;
  }
  .inner {
    width: min(1180px, 100%);
    margin-inline: auto;
  }
  .section {
    padding: clamp(64px, 8vw, 112px) 24px;
  }
  .centered {
    text-align: center;
    margin-bottom: 16px;
  }
  .intro {
    text-align: center;
    font-size: clamp(14px, 0.875rem + ((1vw - 3.2px) * 0.234), 17px);
    margin-bottom: 52px;
  }

  /* Exactly one screen tall: svh ignores mobile browser bars, so nothing below peeks in. */
  .hero {
    position: relative;
    min-height: 100svh;
    display: grid;
    place-items: center;
    padding: 110px 24px 90px;
    text-align: center;
    overflow: hidden;
  }
  .hero-content {
    position: relative;
    z-index: 1;
  }

  .enso {
    position: absolute;
    top: 50%;
    left: 50%;
    width: min(80svh, 94vw);
    transform: translate(-50%, -50%) rotate(-8deg);
  }
  .enso path {
    fill: none;
    stroke: var(--color-matcha);
    stroke-opacity: 0.16;
    stroke-width: 16;
    stroke-linecap: round;
    /* With pathLength="1", one dash covers the whole circle; shifting it by 1 hides it. */
    stroke-dasharray: 1;
  }

  .frame {
    position: absolute;
    inset: 70px 0 32px;
    width: var(--container);
    margin-inline: auto;
    pointer-events: none;
  }
  .corner {
    position: absolute;
    margin: 0;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.18em;
    line-height: 1.5;
    text-transform: uppercase;
    color: var(--color-stone-strong);
  }
  .tl {
    top: 0;
    left: 0;
  }
  .tr {
    top: 0;
    right: 0;
  }
  .bl {
    bottom: 0;
    left: 0;
  }
  .br {
    bottom: 0;
    right: 0;
  }
  .scroll {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .scroll::after {
    content: '';
    width: 40px;
    height: 1px;
    background: currentColor;
  }

  /* Each word is a window with overflow hidden; the padding keeps the comma's tail inside it. */
  .word {
    display: inline-block;
    overflow: hidden;
    vertical-align: top;
    padding-bottom: 0.14em;
    margin-bottom: -0.14em;
  }
  .word > span {
    display: inline-block;
  }

  @media (prefers-reduced-motion: no-preference) {
    .word > span {
      animation: rise 1s cubic-bezier(0.2, 0.7, 0.2, 1) both;
      animation-delay: calc(0.35s + var(--i) * 0.14s);
    }
    /* Subtitle and buttons use their own --d; the corner details follow last. */
    .intro-in,
    .corner {
      animation: fade-up 0.9s cubic-bezier(0.2, 0.7, 0.2, 1) both;
      animation-delay: var(--d, 1.3s);
    }
    .enso path {
      animation: draw 2.6s cubic-bezier(0.65, 0, 0.35, 1) 0.2s both;
    }
    .scroll::after {
      animation: cue 2.4s ease-in-out infinite;
    }
  }
  @keyframes rise {
    from {
      transform: translateY(110%);
    }
  }
  @keyframes fade-up {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
  }
  @keyframes draw {
    from {
      stroke-dashoffset: 1;
      opacity: 0;
    }
    5% {
      opacity: 1;
    }
  }
  /* The line grows from the left, then shrinks away to the right. */
  @keyframes cue {
    0% {
      transform: scaleX(0);
      transform-origin: left;
    }
    50% {
      transform: scaleX(1);
      transform-origin: left;
    }
    51% {
      transform-origin: right;
    }
    100% {
      transform: scaleX(0);
      transform-origin: right;
    }
  }
  .hero h1 {
    font-size: clamp(44px, 7vw, 78px);
    line-height: 1.12;
    margin-bottom: 26px;
  }
  .hero-content p {
    font-size: clamp(14px, 0.875rem + ((1vw - 3.2px) * 0.391), 19px);
    line-height: 1.65;
    margin-bottom: 44px;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
  }
  .actions .button {
    padding: 17px 38px;
  }
  .cover {
    position: relative;
    min-height: 100vh;
    overflow: hidden;
    /* Names this element's scroll progress, so animations can follow it. */
    view-timeline-name: --cover;
  }
  .cover :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* Scroll-driven reveal: the photo unmasks and settles as it scrolls into view.
     Browsers without scroll-driven animations simply show it in its final state. */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      /* Longhands on purpose: the CSS minifier folds animation-timeline into the
         "animation" shorthand, which Chrome rejects, so the shorthand can't be used here. */
      .cover {
        animation-name: unmask;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: --cover;
        animation-range: entry 0% cover 45%;
      }
      .cover :global(img) {
        animation-name: settle;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: --cover;
        animation-range: entry 0% cover 60%;
      }
    }
  }
  /* Bottom layering: the photo sits above "Our story", which starts tucked under it. */
  .cover-layer {
    position: relative;
    z-index: 1;
  }
  /* Shadow strip under the photo's bottom edge. A box-shadow would be cut off by the
     clip-path reveal above, so it lives on the wrapper instead. */
  .cover-layer::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: 100%;
    height: 48px;
    background: linear-gradient(rgba(26, 26, 26, 0.16), rgba(26, 26, 26, 0));
    pointer-events: none;
  }
  .story {
    position: relative;
    z-index: 0;
  }
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .story {
        animation-name: from-under;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: view();
        animation-range: entry 0% entry 100%;
      }
    }
  }
  @keyframes from-under {
    from {
      transform: translateY(-35%);
    }
  }
  @keyframes unmask {
    from {
      clip-path: inset(10% 14%);
    }
    to {
      clip-path: inset(0);
    }
  }
  @keyframes settle {
    from {
      transform: scale(1.2);
    }
    to {
      transform: scale(1);
    }
  }

  .story {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: 64px;
    /* 1120px of content plus the 24px side padding. */
    max-width: 1168px;
    margin-inline: auto;
    padding-block: clamp(72px, 9vw, 128px);
  }
  .eyebrow {
    color: var(--color-matcha);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    margin-bottom: 20px;
  }
  .story h2 {
    margin-bottom: 24px;
  }
  .story-text p:not(.eyebrow):not(.more) {
    font-size: clamp(14px, 0.875rem + ((1vw - 3.2px) * 0.234), 17px);
    line-height: 1.75;
    margin-bottom: 28px;
  }
  .more {
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin: 0;
  }
  .more a {
    color: var(--color-stone-strong);
  }

  .tiles {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    max-width: 1228px;
    margin-inline: auto;
    padding-top: clamp(56px, 7vw, 96px);
  }
  .tile {
    position: relative;
    min-height: 420px;
    padding: 28px;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    align-items: flex-start;
    color: var(--color-paper);
    overflow: hidden;
  }
  .tile :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* 40% ink overlay so the white text stays readable on any photo. */
  .tile::after {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(26, 26, 26, 0.4);
  }
  .tile h3,
  .tile a {
    position: relative;
    z-index: 1;
  }
  .tile h3 {
    font-size: clamp(16.834px, 1.052rem + ((1vw - 3.2px) * 0.716), 26px);
    line-height: 1.3;
    margin: 0 0 10px;
  }
  .tile a {
    color: var(--color-paper);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;
  }
  .tile a:hover {
    text-decoration: underline;
  }

  .journal-title {
    margin-bottom: 48px;
  }
  .posts {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
  }
  .posts :global(img) {
    width: 100%;
    aspect-ratio: 2 / 3;
    object-fit: cover;
    margin-bottom: 10px;
  }
  .post-title {
    display: block;
    font-size: 14px;
    color: var(--color-stone-strong);
    text-decoration: none;
    margin-bottom: 6px;
  }
  .post-title:hover {
    color: var(--color-matcha);
  }
  .posts p {
    font-size: 14px;
    margin: 0;
  }

  .signup-section {
    padding: 0 24px clamp(72px, 9vw, 120px);
    text-align: center;
  }
  hr {
    width: min(620px, 100%);
    height: 1px;
    border: 0;
    background: var(--color-stone);
    margin: 0 auto clamp(56px, 7vw, 96px);
  }
  .signup-section h2 {
    font-size: clamp(26px, 3.4vw, 34px);
    line-height: 1.25;
    margin-bottom: 14px;
  }
  .signup-section > p {
    font-size: clamp(14px, 0.875rem + ((1vw - 3.2px) * 0.156), 16px);
    margin-bottom: 32px;
  }
  .signup {
    max-width: 520px;
    margin: 0 auto;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
  }
  .signup input {
    flex: 1 1 260px;
    width: auto;
    min-width: 0;
  }
  .signup .button {
    padding: 15px 34px;
  }
  .note {
    flex-basis: 100%;
    margin: 4px 0 0;
    font-size: 14px;
    color: var(--color-matcha);
  }

  /* WordPress stacks columns below 782px. */
  @media (max-width: 781.98px) {
    .story,
    .tiles,
    .posts {
      grid-template-columns: 1fr;
    }
    .story {
      gap: 40px;
    }
  }
</style>
