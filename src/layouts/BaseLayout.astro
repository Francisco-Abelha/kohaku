---
import type { ImageMetadata } from 'astro';
import { Font, getImage } from 'astro:assets';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CartDrawer from '../components/CartDrawer.astro';
import heroImage from '../assets/products/matcha-bowl-primary-scaled.jpg';
import '../styles/global.css';

interface Props {
  title?: string;
  /** The search result snippet and link preview text. */
  description?: string;
  /** The link preview photo; the home hero photo if not given. */
  image?: ImageMetadata;
  /** Pages search engines should skip, such as the thank-you page. */
  noindex?: boolean;
  /** Home page: the notice floats over the full-screen hero instead of pushing it down. */
  fullScreenHero?: boolean;
}

const {
  title,
  description = 'Single-origin matcha from Uji, Nishio and Yame, and the tools to prepare it. Kohaku is a concept store: no real orders are taken.',
  image = heroImage,
  noindex = false,
  fullScreenHero = false,
} = Astro.props;
// Same title format as WordPress.
const fullTitle = title ? `${title} – Kohaku` : 'Kohaku – single-origin matcha';

// Link previews need absolute addresses, built from `site` in astro.config.mjs.
const pageUrl = new URL(Astro.url.pathname, Astro.site);
// 1200×630 is the size WhatsApp, LinkedIn, iMessage and others expect; the photo is cropped to fit.
const preview = await getImage({ src: image, width: 1200, height: 630, fit: 'cover', format: 'jpg' });
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <Font cssVariable="--font-instrument" preload />
    <Font cssVariable="--font-cormorant" preload />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={pageUrl} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="sitemap" href="/sitemap-index.xml" />
    <!-- Open Graph: what a pasted link shows in chat apps and social sites. -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Kohaku" />
    <meta property="og:title" content={title ?? fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={new URL(preview.src, Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <!-- Must run before the page's first paint, so it's an inline script in <head>.
         Arriving back from a product page: tag the matching card's photo so it morphs back into place. -->
    <script is:inline>
      window.addEventListener('pagereveal', (event) => {
        // Card tags only matter during a transition. Pages restored from the back/forward
        // cache still carry the tag from the click that left them, so clear tags afterwards.
        const clearCardTags = () =>
          document.querySelectorAll('[data-product] img[data-vt-product]').forEach((img) => img.removeAttribute('data-vt-product'));
        const transition = event.viewTransition;
        if (!transition) return clearCardTags();
        transition.finished.finally(clearCardTags);

        // Skip if a photo is already tagged (a product page's gallery, or a restored page).
        if (document.querySelector('[data-vt-product]')) return;
        const from = window.navigation?.activation?.from?.url;
        const id = from && new URL(from).pathname.match(/^\/product\/([^/]+)\/$/)?.[1];
        // The shop shows each photo twice (row and fixed stage), one hidden: tag the visible one.
        [...document.querySelectorAll(`[data-product="${id}"] img`)]
          .find((img) => img.checkVisibility())
          ?.setAttribute('data-vt-product', '');
      });
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <p class:list={['notice', { overlay: fullScreenHero }]}>Concept store. No real orders are taken.</p>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <CartDrawer />
  </body>
</html>

<script>
  import { validate, type Errors, type Field, type FormName } from '../lib/forms';

  // Page transitions, going forward: tag only the clicked card's photo, so just that
  // one photo morphs into the product page (its gallery carries the same tag).
  document.addEventListener('click', (event) => {
    const card = (event.target as Element).closest('[data-product] a[href^="/product/"]')?.closest<HTMLElement>('[data-product]');
    if (!card) return;
    // The card's own photo, or (shop page, wide screens) the visible stage copy of it.
    const own = card.querySelector('img');
    const img = own?.checkVisibility()
      ? own
      : [...document.querySelectorAll(`[data-product="${card.dataset.product}"] img`)].find((el) => el.checkVisibility());
    if (!img) return;
    // A product page's own gallery is tagged too; names must be unique, so untag it first.
    document.querySelectorAll('[data-vt-product]').forEach((el) => el.removeAttribute('data-vt-product'));
    img.setAttribute('data-vt-product', '');
  });

  // Forms (contact, newsletter): checked when you leave a field, as you fix one that shows an
  // error, and on submit; then sent to /api/forms/, which checks again (src/lib/forms.ts).
  const thanks: Record<FormName, string> = {
    contact: 'Thank you, your message arrived. Kohaku is a concept store, so it isn’t kept and nobody will reply.',
    newsletter: 'Thank you. Kohaku is a concept store, so your address isn’t kept and no emails will be sent.',
  };

  for (const form of document.querySelectorAll<HTMLFormElement>('form[data-form]')) {
    const name = form.dataset.form as FormName;
    const fields = [...form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('.field')];
    const note = form.querySelector<HTMLElement>('.note')!;
    const button = form.querySelector<HTMLButtonElement>('[type="submit"]')!;
    // Our own messages replace the browser's bubbles; `required` stays on the fields for screen readers.
    form.noValidate = true;

    const values = () => Object.fromEntries(new FormData(form)) as Record<string, string>;
    const show = (errors: Errors, only?: Element) => {
      for (const field of fields) {
        if (only && field !== only) continue;
        const message = errors[field.name as Field] ?? '';
        document.getElementById(field.getAttribute('aria-describedby')!)!.textContent = message;
        if (message) field.setAttribute('aria-invalid', 'true');
        else field.removeAttribute('aria-invalid');
      }
    };

    for (const field of fields) {
      // Leaving a field with something typed in it: check it. Leaving it empty isn't an error yet.
      field.addEventListener('blur', () => field.value && show(validate(name, values()), field));
      // Once a field shows an error, the message updates (and clears) as it's fixed.
      field.addEventListener('input', () => field.hasAttribute('aria-invalid') && show(validate(name, values()), field));
    }

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      note.textContent = '';
      const errors = validate(name, values());
      show(errors);
      const firstInvalid = fields.find((field) => field.hasAttribute('aria-invalid'));
      if (firstInvalid) return firstInvalid.focus();

      button.disabled = true;
      try {
        const response = await fetch('/api/forms/', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ form: name, ...values() }),
        });
        const data = await response.json();
        if (data.errors) {
          show(data.errors);
          fields.find((field) => field.hasAttribute('aria-invalid'))?.focus();
        } else if (!response.ok) {
          throw new Error();
        } else {
          form.reset();
          note.textContent = thanks[name];
        }
      } catch {
        note.textContent = 'That didn’t go through. Check your connection and try again.';
      } finally {
        button.disabled = false;
      }
    });
  }
</script>

<style>
  .notice {
    margin: 0;
    padding: 8px 16px;
    background: var(--color-sand);
    color: var(--color-ink);
    font-size: 0.75rem;
    line-height: 1.5;
    letter-spacing: 0.05em;
    text-align: center;
  }
  /* Floats over the top of the full-screen hero instead of pushing it down. */
  .notice.overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    z-index: 10;
  }

  .skip-link {
    position: absolute;
    left: 16px;
    top: -100px;
    padding: 8px 16px;
    background: var(--color-ink);
    color: var(--color-paper);
    z-index: 200;
  }
  .skip-link:focus {
    top: 8px;
  }
</style>
