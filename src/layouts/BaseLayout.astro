---
import { Font } from 'astro:assets';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  /** Home page: the notice floats over the full-screen hero instead of pushing it down. */
  fullScreenHero?: boolean;
}

const { title, fullScreenHero = false } = Astro.props;
// Same title format as WordPress.
const fullTitle = title ? `${title} – Kohaku` : 'Kohaku – single-origin matcha';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <Font cssVariable="--font-inter" preload />
    <Font cssVariable="--font-cormorant" preload />
    <title>{fullTitle}</title>
    <!-- Must run before the page's first paint, so it's an inline script in <head>.
         Arriving back from a product page: tag the matching card's photo so it morphs back into place. -->
    <script is:inline>
      window.addEventListener('pagereveal', (event) => {
        // Card tags only matter during a transition. Pages restored from the back/forward
        // cache still carry the tag from the click that left them, so clear tags afterwards.
        const clearCardTags = () =>
          document.querySelectorAll('[data-product] img[data-vt-product]').forEach((img) => img.removeAttribute('data-vt-product'));
        const transition = event.viewTransition;
        if (!transition) return clearCardTags();
        transition.finished.finally(clearCardTags);

        // Skip if a photo is already tagged (a product page's gallery, or a restored page).
        if (document.querySelector('[data-vt-product]')) return;
        const from = window.navigation?.activation?.from?.url;
        const id = from && new URL(from).pathname.match(/^\/product\/([^/]+)\/$/)?.[1];
        // The shop shows each photo twice (row and fixed stage), one hidden: tag the visible one.
        [...document.querySelectorAll(`[data-product="${id}"] img`)]
          .find((img) => img.checkVisibility())
          ?.setAttribute('data-vt-product', '');
      });
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <p class:list={['notice', { overlay: fullScreenHero }]}>Concept store · no real orders are taken</p>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<script>
  // Scroll reveals: [data-reveal] elements fade up the first time they scroll into view.
  // Skipped entirely under reduced motion, so nothing is ever hidden for those visitors.
  const revealables = document.querySelectorAll<HTMLElement>('[data-reveal]');
  if (revealables.length && matchMedia('(prefers-reduced-motion: no-preference)').matches) {
    for (const group of document.querySelectorAll<HTMLElement>('[data-reveal="stagger"]')) {
      [...group.children].forEach((child, i) => (child as HTMLElement).style.setProperty('--reveal-delay', `${i * 90}ms`));
    }
    // IntersectionObserver reports when an element enters the viewport, without a scroll listener.
    // The negative bottom margin waits until an element is 12% of the way up the screen.
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          entry.target.classList.add('is-revealed');
          observer.unobserve(entry.target); // reveal once, never hide again
        }
      },
      { rootMargin: '0px 0px -12% 0px' },
    );
    // Coming back with the back/forward buttons, whatever is already on screen shows at once:
    // replaying the fade there would fight the photo morphing back into its card.
    const returning = (performance.getEntriesByType('navigation')[0] as PerformanceNavigationTiming | undefined)?.type === 'back_forward';
    for (const el of revealables) {
      if (returning && el.getBoundingClientRect().top < innerHeight * 0.88) el.classList.add('is-revealed');
    }
    document.documentElement.classList.add('reveal-ready');
    // Reading a layout value makes the browser apply the hidden state right now. Without it,
    // elements already on screen would be hidden and revealed in the same frame, so they'd
    // just appear instead of animating in.
    void document.body.offsetHeight;
    revealables.forEach((el) => el.classList.contains('is-revealed') || observer.observe(el));
  }

  // Page transitions, going forward: tag only the clicked card's photo, so just that
  // one photo morphs into the product page (its gallery carries the same tag).
  document.addEventListener('click', (event) => {
    const card = (event.target as Element).closest('[data-product] a[href^="/product/"]')?.closest<HTMLElement>('[data-product]');
    if (!card) return;
    // The card's own photo, or (shop page, wide screens) the visible stage copy of it.
    const own = card.querySelector('img');
    const img = own?.checkVisibility()
      ? own
      : [...document.querySelectorAll(`[data-product="${card.dataset.product}"] img`)].find((el) => el.checkVisibility());
    if (!img) return;
    // A product page's own gallery is tagged too; names must be unique, so untag it first.
    document.querySelectorAll('[data-vt-product]').forEach((el) => el.removeAttribute('data-vt-product'));
    img.setAttribute('data-vt-product', '');
  });

  // shortcut: forms marked data-demo only show their note, like on WordPress; phase 4 makes them real.
  for (const form of document.querySelectorAll<HTMLFormElement>('form[data-demo]')) {
    form.addEventListener('submit', (event) => {
      event.preventDefault();
      form.querySelector<HTMLElement>('.note')!.hidden = false;
    });
  }
</script>

<style>
  .notice {
    margin: 0;
    padding: 8px 16px;
    background: var(--color-sand);
    color: var(--color-ink);
    font-size: 0.75rem;
    line-height: 1.5;
    letter-spacing: 0.05em;
    text-align: center;
  }
  /* Floats over the top of the full-screen hero instead of pushing it down. */
  .notice.overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    z-index: 10;
  }

  .skip-link {
    position: absolute;
    left: 16px;
    top: -100px;
    padding: 8px 16px;
    background: var(--color-ink);
    color: var(--color-paper);
    z-index: 200;
  }
  .skip-link:focus {
    top: 8px;
  }
</style>
