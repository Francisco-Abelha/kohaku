---
import { Font } from 'astro:assets';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  /** Home page: the header starts hidden and the notice floats over the full-screen hero. */
  autoHideHeader?: boolean;
}

const { title, autoHideHeader = false } = Astro.props;
// Same title format as WordPress.
const fullTitle = title ? `${title} – Kohaku` : 'Kohaku – single-origin matcha';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <Font cssVariable="--font-inter" preload />
    <Font cssVariable="--font-cormorant" preload />
    <title>{fullTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <p class:list={['notice', { overlay: autoHideHeader }]}>Concept store · no real orders are taken</p>
    <Header autoHide={autoHideHeader} />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<script>
  // Scroll reveals: [data-reveal] elements fade up the first time they scroll into view.
  // Skipped entirely under reduced motion, so nothing is ever hidden for those visitors.
  const revealables = document.querySelectorAll<HTMLElement>('[data-reveal]');
  if (revealables.length && matchMedia('(prefers-reduced-motion: no-preference)').matches) {
    for (const group of document.querySelectorAll<HTMLElement>('[data-reveal="stagger"]')) {
      [...group.children].forEach((child, i) => (child as HTMLElement).style.setProperty('--reveal-delay', `${i * 90}ms`));
    }
    // IntersectionObserver reports when an element enters the viewport, without a scroll listener.
    // The negative bottom margin waits until an element is 12% of the way up the screen.
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          entry.target.classList.add('is-revealed');
          observer.unobserve(entry.target); // reveal once, never hide again
        }
      },
      { rootMargin: '0px 0px -12% 0px' },
    );
    revealables.forEach((el) => observer.observe(el));
    document.documentElement.classList.add('reveal-ready');
  }

  // shortcut: forms marked data-demo only show their note, like on WordPress; phase 4 makes them real.
  for (const form of document.querySelectorAll<HTMLFormElement>('form[data-demo]')) {
    form.addEventListener('submit', (event) => {
      event.preventDefault();
      form.querySelector<HTMLElement>('.note')!.hidden = false;
    });
  }
</script>

<style>
  .notice {
    margin: 0;
    padding: 8px 16px;
    background: var(--color-sand);
    color: var(--color-ink);
    font-size: 12px;
    line-height: 1.5;
    letter-spacing: 0.05em;
    text-align: center;
  }
  /* Floats over the top of the full-screen hero instead of pushing it down. */
  .notice.overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    z-index: 10;
  }

  .skip-link {
    position: absolute;
    left: 16px;
    top: -100px;
    padding: 8px 16px;
    background: var(--color-ink);
    color: var(--color-paper);
    z-index: 200;
  }
  .skip-link:focus {
    top: 8px;
  }
</style>
